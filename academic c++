#include <iostream>
using namespace std;
class Student {
private:
    int rollNo;
    float marks;
public:
    static string collegeName;
    Student(int r, float m) {
        rollNo = r;
        marks = m;
}
    void display() {
        cout << "College Name: " << collegeName << endl;
        cout << "Roll No: " << rollNo << endl;
        cout << "Marks: " << marks << endl;
        cout << "-" << endl;
    }
};
string Student::collegeName = "ABC Engineering College";

int main() {
    Student s1(101, 85.5);
    Student s2(102, 90.0);
      Student s3(103, 78.5);
    s1.display();
    s2.display();
    s3.display();
    return 0;
}
